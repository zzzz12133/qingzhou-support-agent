# ===== Agent 模型 =====
# 默认 mock：不用 Key 也能完整演示工具、RAG、记忆和流式 UI。
# 改成 deepseek 后，在下面填 DEEPSEEK_API_KEY，重启服务即可切真实模型。
LLM_PROVIDER=mock
LLM_FALLBACKS=

# DeepSeek（OpenAI 兼容接口）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# 任意 OpenAI 兼容服务（Ollama / vLLM / 公司网关）
# 把 LLM_PROVIDER 改成 custom，再填下面三项。
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ===== 运行参数（一般不用改）=====
# LLM_TIMEOUT_SECONDS=25
# MAX_TOOL_ROUNDS=4
# RECENT_MESSAGES=12
# SUMMARY_TRIGGER=16
# CONTEXT_TOKEN_BUDGET=3200
# ENABLE_SEMANTIC_CACHE=true
# CACHE_TTL_SECONDS=600
# TOOL_DELAY_SECONDS=0.18

# Spring Boot 默认 8088；改端口时 start.ps1 的 -BackendPort 也要对应。
# SERVER_PORT=8088
# RATE_LIMIT_PER_MINUTE=20
# MAX_CONCURRENT_PER_USER=2
